# Firebase-Konfiguration für die Synchronisierung zwischen Geräten.
# Werte aus der Firebase-Konsole kopieren (siehe FIREBASE_SETUP.md).
# Diese Datei als .env.local speichern (wird von Vite automatisch geladen, nicht committen).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Geheime iCal-Adresse des geteilten Garde-Kalenders (Google Kalender ->
# Einstellungen für diesen Kalender -> "Kalender integrieren" -> "Geheime
# Adresse im iCal-Format"). NICHT mit VITE_-Präfix, da sie nur von der
# Serverless-Function (api/ics.js) gelesen wird, nie im Browser sichtbar
# sein darf. In Vercel als Environment Variable eintragen, nicht hier.
ICS_URL=
